{
  // Cloudflare Workers static hosting for the Suivix app (app.suivix.co).
  // Build command: npm run build — deploy command: npx wrangler deploy
  "name": "suivix-app",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/dossiers, /suivi/SVX-…) all serve index.html.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "app.suivix.co", "custom_domain": true }]
}
